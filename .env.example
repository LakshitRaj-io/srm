# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Server-only OpenAI key for the SRM Guide and programme suggestions.
# Leave empty to run without AI: both features then show labelled keyword matches.
OPENAI_API_KEY=

# Optional. Model used for suggestions (default: gpt-4.1-mini).
OPENAI_MODEL=

# Optional. Base URL of an OpenAI-compatible API (default: https://api.openai.com/v1).
OPENAI_BASE_URL=
